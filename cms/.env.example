# --- Server ---
HOST=0.0.0.0
PORT=1337

# Comma-separated list of base64 strings used to sign admin & API tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# four times, joined by commas.
APP_KEYS=key1,key2,key3,key4

# Admin auth + token salts. Generate each independently with the snippet above.
API_TOKEN_SALT=replace_me
ADMIN_JWT_SECRET=replace_me
TRANSFER_TOKEN_SALT=replace_me

# JWT secret for the users-permissions plugin (we don't use it for the blog,
# but Strapi will refuse to boot without it).
JWT_SECRET=replace_me

# --- Database (SQLite on a GCS-mounted volume in production) ---
# In local dev leave it pointing at .tmp/data.db. In Cloud Run we mount the
# GCS bucket at /data and point DATABASE_FILENAME at /data/cms.db.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# --- Uploads (Google Cloud Storage) ---
# Bucket the upload provider writes to. The Cloud Run service account must
# have roles/storage.objectAdmin on it.
GCS_BUCKET_NAME=fuelcue-cms-uploads
GCS_BASE_PATH=blog
# In Cloud Run we use Application Default Credentials, so GCS_SERVICE_ACCOUNT
# can stay unset. For local dev set it to the absolute path of a service
# account JSON key, or run `gcloud auth application-default login`.
# GCS_SERVICE_ACCOUNT=/path/to/sa-key.json

# --- Public URL ---
# Used by Strapi to construct admin links and absolute asset URLs when the
# upload provider returns relative paths. Set to the public URL of this
# Cloud Run service.
PUBLIC_URL=https://cms.fuelcue.com
