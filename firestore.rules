rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User-owned subtree: only the signed-in owner can read/write their own data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public early-access waitlist: anyone may submit a single, shape-validated
    // record. No reads, updates, or deletes from clients — admin SDK (Cloud
    // Function) handles those internally.
    match /earlyAccessRequests/{docId} {
      allow create: if isValidEarlyAccessSubmission(request.resource.data);
      allow read, update, delete: if false;
    }

    // Site-wide feedback banner: signed-in or anonymous can submit. Admin
    // dashboard reads via callable (Admin SDK).
    match /siteFeedback/{docId} {
      allow create: if isValidSiteFeedback(request.resource.data);
      allow read, update, delete: if false;
    }

    // Orders: only the customer (matched by email) can read their own order.
    // All writes go through the Cloud Function via Admin SDK (bypasses rules).
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && request.auth.token.email == resource.data.customer.email;
      allow write: if false;
    }

    // Admin allowlist — managed only via callable Cloud Functions.
    match /admins/{email} {
      allow read, write: if false;
    }

    // Coupons — all reads/writes go through callable Cloud Functions
    // (validateCoupon for public, adminUpsertCoupon/Delete/List for admins).
    // The Admin SDK inside the function bypasses these rules.
    match /coupons/{code} {
      allow read, write: if false;
      match /redemptions/{orderId} {
        allow read, write: if false;
      }
    }

    // Blog posts — public can read posts whose `published` flag is true and
    // whose `publishedAt` has already elapsed. Drafts and scheduled posts are
    // invisible to anonymous readers. All writes flow through admin callables.
    match /posts/{postId} {
      allow read: if resource.data.published == true
                  && resource.data.publishedAt <= request.time;
      allow write: if false;
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidSiteFeedback(d) {
      return d.keys().hasOnly(
               ['message', 'email', 'displayName', 'uid',
                'path', 'userAgent', 'referrer', 'createdAt']
             )
             && d.message is string && d.message.size() > 0 && d.message.size() <= 4000
             && (d.email == null      || (d.email is string      && d.email.size() <= 200))
             && (d.displayName == null || (d.displayName is string && d.displayName.size() <= 200))
             && (d.uid == null        || (d.uid is string        && d.uid.size() <= 128))
             && (d.path == null       || (d.path is string       && d.path.size() <= 500))
             && (d.userAgent == null  || (d.userAgent is string  && d.userAgent.size() <= 500))
             && (d.referrer == null   || (d.referrer is string   && d.referrer.size() <= 500))
             && d.createdAt == request.time;
    }

    function isValidEarlyAccessSubmission(d) {
      return d.keys().hasOnly(
               ['name', 'email', 'sports', 'notes',
                'createdAt', 'userAgent', 'referrer']
             )
             && d.name is string    && d.name.size()  > 0   && d.name.size()  <= 200
             && d.email is string   && d.email.size() > 0   && d.email.size() <= 200
             && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
             && d.sports is list && d.sports.size() <= 10
             && (d.notes    == null || (d.notes is string    && d.notes.size()    <= 2000))
             && (d.userAgent == null || (d.userAgent is string && d.userAgent.size() <= 500))
             && (d.referrer == null || (d.referrer is string && d.referrer.size() <= 500))
             && d.createdAt == request.time;
    }
  }
}
